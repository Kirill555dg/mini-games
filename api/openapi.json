  "info": {
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit/"
    },
    "title": "Mini-games API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/game-api/action": {
      "post": {
        "operationId": "sendAction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rooms_Command"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rooms_View"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    },
    "/game-api/events": {
      "get": {
        "operationId": "events",
        "parameters": [
          {
            "in": "query",
            "name": "room",
            "required": false,
            "schema": {
              "pattern": "^[ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]{6}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "SSE state events: Lobby or viewer-specific View; null means room closed"
          }
        }
      }
    },
    "/game-api/history": {
      "get": {
        "operationId": "getHistory",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/history_Record"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    },
    "/game-api/lobby": {
      "get": {
        "operationId": "getLobby",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rooms_Lobby"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    },
    "/game-api/state": {
      "get": {
        "operationId": "getRoom",
        "parameters": [
          {
            "in": "query",
            "name": "room",
            "required": true,
            "schema": {
              "pattern": "^[ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]{6}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rooms_View"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    },
    "/game-api/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_Status"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    },
    "/game-api/visit": {
      "post": {
        "operationId": "trackVisit",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_VisitResponse"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpapi_ErrorResponse"
                }
              }
            },
            "description": "Request rejected"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-game-values": {
    "draw": -2,
    "finished": "finished",
    "noWinner": -1,
    "playing": "playing",
    "setup": "setup"
  },
  "x-naval-cells": {
    "clear": -2,
    "hit": 2,
    "miss": -1,
    "ship": 1,
    "sunk": 3,
    "water": 0
  },
  "x-room-actions": {
    "acceptSwap": "accept-swap",
    "cancelSwap": "cancel-swap",
    "create": "create",
    "enter": "enter",
    "leave": "leave",
    "move": "move",
    "ready": "ready",
    "seat": "seat"
  },
  "x-room-code": {
    "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "length": 6,
    "maxNameRunes": 24
  }
}
